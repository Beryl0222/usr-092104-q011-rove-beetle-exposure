{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "隐翅虫暴露分级随访领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "EXPOSURE_REPORTED",
        "SYMPTOM_UPDATED",
        "GUIDANCE_ISSUED",
        "CASE_ESCALATED",
        "FOLLOWUP_CLOSED",
        "CALL_LINKED",
        "FACILITY_OUTCOME_RECORDED",
        "REVIEW_RESOLVED",
        "CLUSTER_REPORTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "exposure_case",
        "symptom_observation",
        "triage_assessment",
        "followup_episode",
        "cluster_report"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "事件负载，结构随 event_type 而定；基础信封字段保持稳定，扩展只发生在 payload 内"
    }
  },
  "additionalProperties": true
}
